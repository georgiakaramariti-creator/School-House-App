rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && profile().data.role == 'admin';
    }

    function isParent() {
      return signedIn() && profile().data.role == 'parent';
    }

    function ownsExistingStudent() {
      return isParent() && (
        resource.data.parentUid == request.auth.uid ||
        (resource.data.parentEmail == request.auth.token.email && request.auth.token.email_verified == true)
      );
    }

    function ownsIncomingStudent() {
      return isParent() && (
        request.resource.data.parentUid == request.auth.uid ||
        (request.resource.data.parentEmail == request.auth.token.email && request.auth.token.email_verified == true)
      );
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || ownsExistingStudent();
      allow create, update, delete: if isAdmin();
    }

    match /absences/{entryId} {
      allow read: if isAdmin() || ownsExistingStudent();
      allow create, update, delete: if isAdmin();
    }

    match /tuition/{entryId} {
      allow read: if isAdmin() || ownsExistingStudent();
      allow create, update, delete: if isAdmin();
    }

    match /payments/{entryId} {
      allow read: if isAdmin() || ownsExistingStudent();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
